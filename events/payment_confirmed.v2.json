{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaymentConfirmed v2",
  "type": "object",
  "required": ["event_id","event_type","schema_version","occurred_at","organization_id","partition_key","payload"],
  "properties": {
    "event_id": {"type":"string","format":"uuid","description":"ключ дедупликации в processed_event"},
    "event_type": {"const":"PaymentConfirmed"},
    "schema_version": {"const":2},
    "occurred_at": {"type":"string","format":"date-time"},
    "organization_id": {"type":"string","format":"uuid"},
    "topic": {"const":"rentflow.payment"},
    "partition_key": {"type":"string","description":"invoice_id: все события одного счёта в одной партиции"},
    "payload": {"type":"object","required":["payment_id","invoice_id","amount","currency","provider","provider_payment_id"],"properties":{"payment_id":{"type":"string","format":"uuid"},"invoice_id":{"type":"string","format":"uuid"},"amount":{"type":"string","pattern":"^[0-9]+\\.[0-9]{2}$"},"currency":{"type":"string"},"provider":{"type":"string"},"provider_payment_id":{"type":"string"}}}
  }
}
