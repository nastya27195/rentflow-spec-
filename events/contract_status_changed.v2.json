{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContractStatusChanged v2",
  "type": "object",
  "required": ["event_id","event_type","schema_version","occurred_at","organization_id","partition_key","payload"],
  "properties": {
    "event_id": {"type":"string","format":"uuid"},
