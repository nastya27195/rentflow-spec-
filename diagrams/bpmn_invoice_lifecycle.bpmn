<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_RentFlow" targetNamespace="https://rentflow.ru/bpmn" exporter="RentFlow spec" exporterVersion="1.0">
  <bpmn:process id="Process_InvoiceLifecycle" name="Выставление счёта и оплата" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Ежедневно 00:05">
      <bpmn:outgoing>f1</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeCycle xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">0 5 0 * * ?</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Select" name="Выбрать договоры ACTIVE с next_billing_date ≤ today">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Issue" name="Сформировать счёт (ISSUED), сдвинуть next_billing_date">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_Publish" name="Опубликовать InvoiceIssued">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_Notify" name="Уведомить арендатора">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_Pay" name="Арендатор оплачивает счёт через шлюз">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1" name="Оплачен до due_date?">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Webhook" name="Обработать webhook, подтвердить платёж">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_PubPaid" name="Опубликовать PaymentConfirmed">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Paid" name="Счёт PAID">
      <bpmn:incoming>f9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Overdue" name="Проставить overdue_since, начислить пеню (penalty)">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_TaskMgr" name="Создать задачу менеджеру, опубликовать InvoiceOverdue">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Overdue" name="Ожидание оплаты / эскалация">
      <bpmn:incoming>f12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="StartEvent_1" targetRef="Task_Select" />
    <bpmn:sequenceFlow id="f2" sourceRef="Task_Select" targetRef="Task_Issue" />
    <bpmn:sequenceFlow id="f3" sourceRef="Task_Issue" targetRef="Task_Publish" />
    <bpmn:sequenceFlow id="f4" sourceRef="Task_Publish" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="f5" sourceRef="Task_Notify" targetRef="Task_Pay" />
    <bpmn:sequenceFlow id="f6" sourceRef="Task_Pay" targetRef="Gateway_1" />
    <bpmn:sequenceFlow id="f7" name="да" sourceRef="Gateway_1" targetRef="Task_Webhook" />
    <bpmn:sequenceFlow id="f8" sourceRef="Task_Webhook" targetRef="Task_PubPaid" />
    <bpmn:sequenceFlow id="f9" sourceRef="Task_PubPaid" targetRef="End_Paid" />
    <bpmn:sequenceFlow id="f10" name="нет" sourceRef="Gateway_1" targetRef="Task_Overdue" />
    <bpmn:sequenceFlow id="f11" sourceRef="Task_Overdue" targetRef="Task_TaskMgr" />
    <bpmn:sequenceFlow id="f12" sourceRef="Task_TaskMgr" targetRef="End_Overdue" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_InvoiceLifecycle">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="100" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="60" y="241" width="116" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Select_di" bpmnElement="Task_Select">
        <dc:Bounds x="200" y="180" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Issue_di" bpmnElement="Task_Issue">
        <dc:Bounds x="360" y="180" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Publish_di" bpmnElement="Task_Publish">
        <dc:Bounds x="520" y="180" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Notify_di" bpmnElement="Task_Notify">
        <dc:Bounds x="680" y="180" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Pay_di" bpmnElement="Task_Pay">
        <dc:Bounds x="840" y="180" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1_di" bpmnElement="Gateway_1" isMarkerVisible="true">
        <dc:Bounds x="1000" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="960" y="250" width="130" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Webhook_di" bpmnElement="Task_Webhook">
        <dc:Bounds x="1100" y="80" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PubPaid_di" bpmnElement="Task_PubPaid">
        <dc:Bounds x="1260" y="80" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Paid_di" bpmnElement="End_Paid">
        <dc:Bounds x="1440" y="100" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1400" y="141" width="116" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Overdue_di" bpmnElement="Task_Overdue">
        <dc:Bounds x="1100" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TaskMgr_di" bpmnElement="Task_TaskMgr">
        <dc:Bounds x="1260" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Overdue_di" bpmnElement="End_Overdue">
        <dc:Bounds x="1440" y="300" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1400" y="341" width="116" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="118" y="236" />
        <di:waypoint x="118" y="220" />
        <di:waypoint x="200" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="320" y="220" />
        <di:waypoint x="360" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="480" y="220" />
        <di:waypoint x="520" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="640" y="220" />
        <di:waypoint x="680" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="800" y="220" />
        <di:waypoint x="840" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="960" y="220" />
        <di:waypoint x="1000" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7">
        <di:waypoint x="1025" y="195" />
        <di:waypoint x="1025" y="120" />
        <di:waypoint x="1100" y="120" />
        <bpmndi:BPMNLabel><dc:Bounds x="1030" y="160" width="30" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8">
        <di:waypoint x="1220" y="120" />
        <di:waypoint x="1260" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9">
        <di:waypoint x="1320" y="80" />
        <di:waypoint x="1320" y="118" />
        <di:waypoint x="1440" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f10_di" bpmnElement="f10">
        <di:waypoint x="1025" y="245" />
        <di:waypoint x="1025" y="320" />
        <di:waypoint x="1100" y="320" />
        <bpmndi:BPMNLabel><dc:Bounds x="1030" y="260" width="30" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f11_di" bpmnElement="f11">
        <di:waypoint x="1220" y="320" />
        <di:waypoint x="1260" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f12_di" bpmnElement="f12">
        <di:waypoint x="1320" y="280" />
        <di:waypoint x="1320" y="318" />
        <di:waypoint x="1440" y="318" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
